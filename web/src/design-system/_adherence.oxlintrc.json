{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/feedback/**",
              "components/forms/**",
              "components/overlay/**",
              "components/surfaces/**",
              "explorations/**",
              "ui_kits/extension/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Manrope|JetBrains Mono|Geist))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Manrope, JetBrains Mono, Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|icon|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, icon, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|accent|success|warn)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'accent' | 'success' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Coachmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|html|arrow|copyValue|copyLabel|animate|style|className|key|ref|className|style|children)$/]",
        "message": "<Coachmark> doesn't accept that prop. Declared props: children, html, arrow, copyValue, copyLabel, animate, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Coachmark'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:up|down|left|right)$/]",
        "message": "<Coachmark> arrow must be one of 'up' | 'down' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|mono|leadIcon|trailIcon|copyable|disabled|onChange|id|key|ref|className|style|children)$/]",
        "message": "<GlassInput> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, mono, leadIcon, trailIcon, copyable, disabled, onChange, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|html|variant|avatar|animate|key|ref|className|style|children)$/]",
        "message": "<MessageBubble> doesn't accept that prop. Declared props: children, html, variant, avatar, animate."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:guidance|success|user)$/]",
        "message": "<MessageBubble> variant must be one of 'guidance' | 'success' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pointer'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|style|className|key|ref|className|style|children)$/]",
        "message": "<Pointer> doesn't accept that prop. Declared props: direction, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pointer'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:up|down|left|right)$/]",
        "message": "<Pointer> direction must be one of 'up' | 'down' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|current|variant|showLabel|labelFormat|key|ref|className|style|children)$/]",
        "message": "<ProgressDots> doesn't accept that prop. Declared props: total, current, variant, showLabel, labelFormat."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressDots'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dots|bar)$/]",
        "message": "<ProgressDots> variant must be one of 'dots' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|subtitle|step|totalSteps|collapsed|thinking|advanceLabel|onAdvance|onCollapse|onExpand|showProgress|animate|style|key|ref|className|style|children)$/]",
        "message": "<SidebarPanel> doesn't accept that prop. Declared props: children, title, subtitle, step, totalSteps, collapsed, thinking, advanceLabel, onAdvance, onCollapse, onExpand, showProgress, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spotlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:radius|animate|style|className|key|ref|className|style|children)$/]",
        "message": "<Spotlight> doesn't accept that prop. Declared props: radius, animate, style, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
